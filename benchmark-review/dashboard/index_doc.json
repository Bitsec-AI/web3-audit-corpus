{"text": "<meta name=\"dash-one-writer\">\n<style>\n  .ar { display: flex; flex-direction: column; gap: var(--cds-gap-xl); max-width: 1120px; }\n  .ar-lede { font-size: var(--cds-font-size-heading); line-height: 1.5; margin: 0; max-width: 62ch; color: var(--color-fg); }\n  .ar-lede b { font-family: var(--font-anthropic-serif); font-weight: 400; font-variant-numeric: tabular-nums; }\n  .ar-section { display: flex; flex-direction: column; gap: var(--cds-gap-sm); min-width: 0; }\n  .ar-section h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; text-wrap: balance; }\n  .ar-sub { color: var(--color-fg-muted); font-size: var(--cds-font-size-body); margin: 0; max-width: 70ch; line-height: 1.5; }\n  .ar-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); min-width: 0; }\n  .ar-chart { position: relative; min-height: 220px; }\n  .ar-chart svg { display: block; width: 100%; overflow: visible; }\n  .ar-chart text { font-family: var(--font-anthropic-sans); }\n  .ar-scroll { overflow-x: auto; }\n  .ar-table { width: 100%; border-collapse: collapse; font-size: var(--cds-font-size-body); font-variant-numeric: tabular-nums; }\n  .ar-table th { text-align: left; font-weight: var(--cds-font-weight-medium); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted);\n    padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); vertical-align: bottom; white-space: nowrap; }\n  .ar-table td { padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n  .ar-table .num { text-align: right; }\n  .ar-table tr.ar-total td { font-weight: var(--cds-font-weight-medium); }\n  .ar-pct::after { content: \"%\"; color: var(--color-fg-muted); margin-left: 1px; }\n  .ar-approx::before { content: \"\u2248 \"; color: var(--color-fg-muted); }\n  .ar-all { color: var(--color-ok); font-weight: var(--cds-font-weight-medium); }\n  .ar-none { color: var(--color-fg-muted); }\n  .ar-table a { color: inherit; }\n  .ar-controls { display: flex; flex-wrap: wrap; gap: var(--cds-gap-md); align-items: center; font-size: var(--cds-font-size-body); }\n  .ar-controls label { display: inline-flex; gap: var(--cds-gap-xs); align-items: center; }\n  .ar-tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border);\n    box-shadow: var(--cds-shadow-popover); border-radius: var(--cds-radius); padding: var(--cds-pad-xs) var(--cds-pad-sm);\n    font-size: var(--cds-font-size-caption); color: var(--color-fg); line-height: 1.45; max-width: 260px; z-index: 2; }\n  .ar-tip span { color: var(--cds-text-secondary); }\n  .ar-notes { font-size: var(--cds-font-size-body); color: var(--color-fg-muted); line-height: 1.55; }\n  .ar-notes summary { cursor: pointer; color: var(--color-fg); }\n  .ar-notes dl { display: grid; grid-template-columns: minmax(120px, max-content) 1fr; gap: var(--cds-gap-xs) var(--cds-gap-md); margin: var(--cds-gap-sm) 0 0; }\n  .ar-notes dt { color: var(--color-fg); font-weight: var(--cds-font-weight-medium); }\n  .ar-notes dd { margin: 0; max-width: 72ch; }\n  @media (max-width: 560px) { .ar-notes dl { grid-template-columns: 1fr; } .ar-notes dd { margin-bottom: var(--cds-gap-xs); } }\n  [data-dash-source-state=refreshing] { opacity: .5; }\n  .ar-tabs { display: flex; gap: var(--cds-gap-xs); border-bottom: 1px solid var(--color-border-line); }\n  .ar-tabs button { font: inherit; font-size: var(--cds-font-size-body); background: none; border: 0; border-bottom: 2px solid transparent;\n    color: var(--color-fg-muted); padding: var(--cds-pad-xs) var(--cds-pad-sm); margin-bottom: -1px; cursor: pointer; }\n  .ar-tabs button[aria-selected=\"true\"] { color: var(--color-fg); border-bottom-color: var(--color-fg); font-weight: var(--cds-font-weight-medium); }\n  .ar-tabs button:focus-visible { outline: 2px solid var(--color-fg); outline-offset: 2px; }\n  .ar-panel { display: flex; flex-direction: column; gap: var(--cds-gap-xl); }\n  .ar-panel[hidden] { display: none; }\n  .ar-two { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--cds-gap-xl); }\n  .ar-table td.ar-wrap { white-space: normal; min-width: 220px; max-width: 420px; }\n  .ar-table td.ar-fns { white-space: normal; min-width: 160px; max-width: 280px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n    font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .ar-sev-high { color: var(--color-bad); font-weight: var(--cds-font-weight-medium); }\n  .ar-low { color: var(--color-warn); }\n</style>\n\n<div class=\"ar\">\n  <nav class=\"ar-tabs\" role=\"tablist\" aria-label=\"Views\">\n    <button type=\"button\" role=\"tab\" id=\"tab-overview\" data-tab=\"overview\" aria-selected=\"true\" aria-controls=\"overview\">Overview</button>\n    <button type=\"button\" role=\"tab\" id=\"tab-starter\" data-tab=\"starter\" aria-selected=\"false\" aria-controls=\"starter\">Starter set</button>\n  </nav>\n\n  <div class=\"ar-panel\" id=\"overview\" role=\"tabpanel\" aria-labelledby=\"tab-overview\" data-tab-panel>\n  <p class=\"ar-lede\" id=\"takeaway\" data-read lang=\"en\">\n    Of <b data-draw=\"num\" data-source=\"headline\" data-field=\"chm_with_text\" data-row=\"0\">\u2014</b> critical, high and medium findings with text,\n    <b data-draw=\"num\" data-fmt=\"pct\" data-source=\"headline\" data-field=\"pct_functions\" data-row=\"0\">\u2014</b>% name a function,\n    <b data-draw=\"num\" data-fmt=\"pct\" data-source=\"headline\" data-field=\"pct_attack\" data-row=\"0\">\u2014</b>% spell out an attack path,\n    <b data-draw=\"num\" data-fmt=\"pct\" data-source=\"headline\" data-field=\"pct_poc\" data-row=\"0\">\u2014</b>% include a PoC test and\n    <b data-draw=\"num\" data-fmt=\"pct\" data-source=\"headline\" data-field=\"pct_fix\" data-row=\"0\">\u2014</b>% include or link a fix.\n    Only <b data-draw=\"num\" data-source=\"headline\" data-field=\"complete_findings\" data-row=\"0\">\u2014</b> have all four.\n  </p>\n\n  <section class=\"ar-section\" id=\"coverage\">\n    <h2>Share of findings that meet each requirement</h2>\n    <p class=\"ar-sub\">Critical, high and medium findings with released text. A fix counts as a diff in the finding or a link to the fix commit or pull request.</p>\n    <div class=\"ar-card ar-scroll\">\n      <table class=\"ar-table\" data-source=\"coverage_by_platform\" data-row-key=\"platform\" aria-label=\"Requirement coverage by platform\">\n        <thead><tr>\n          <th data-field=\"platform\">Source</th>\n          <th class=\"num\" data-field=\"audits\">Audits</th>\n          <th class=\"num\" data-field=\"findings\">Findings</th>\n          <th class=\"num\" data-field=\"pct_has_functions\">Name a function</th>\n          <th class=\"num\" data-field=\"pct_attack\">Attack path</th>\n          <th class=\"num\" data-field=\"pct_poc\">PoC test</th>\n          <th class=\"num\" data-field=\"pct_fix\">Fix</th>\n          <th class=\"num\" data-field=\"pct_complete\">All four</th>\n        </tr></thead>\n        <tbody data-draw=\"coverage\"></tbody>\n      </table>\n    </div>\n  </section>\n\n  <section class=\"ar-section\" id=\"funnel\">\n    <h2>From every contest to a small starter set</h2>\n    <p class=\"ar-sub\">Sherlock and Code4rena contests. Each step keeps the filters before it. Point at a bar for how many of its findings have a PoC test or a fix.</p>\n    <div class=\"ar-card\"><div class=\"ar-chart\" data-draw=\"funnel\" data-source=\"contest_funnel\" role=\"img\" aria-label=\"Contest funnel: audits remaining after each filter\">\u2014</div></div>\n  </section>\n\n  <section class=\"ar-section\" id=\"size\">\n    <h2>Contests by scope size</h2>\n    <p class=\"ar-sub\">Contests with a known scope size and audited commit, grouped by nSLOC. Point at a bar for its findings and how many name a function or include a PoC test.</p>\n    <div class=\"ar-card\"><div class=\"ar-chart\" data-draw=\"size\" data-source=\"nsloc_buckets\" role=\"img\" aria-label=\"Number of contests in each nSLOC range\">\u2014</div></div>\n  </section>\n\n  <section class=\"ar-section\" id=\"shortlist\">\n    <h2>Candidate audits, smallest first</h2>\n    <p class=\"ar-sub\">Contests with a known scope size, an audited commit and 3 or more critical, high or medium findings. Requirement columns count those findings; green means all of them. \u2248 marks a size taken from line counts rather than nSLOC.</p>\n    <div class=\"ar-controls\">\n      <label for=\"ar-max-loc\">Scope size\n        <select class=\"dash-select\" id=\"ar-max-loc\" aria-label=\"Maximum nSLOC\">\n          <option value=\"\">Any size</option>\n          <option value=\"1000\">Under 1,000 nSLOC</option>\n          <option value=\"2000\" selected>Under 2,000 nSLOC</option>\n          <option value=\"3000\">Under 3,000 nSLOC</option>\n        </select>\n      </label>\n      <label for=\"ar-all-fn\"><input type=\"checkbox\" id=\"ar-all-fn\"> Every finding names a function</label>\n    </div>\n    <div class=\"ar-card ar-scroll\">\n      <table class=\"ar-table\" data-source=\"candidate_audits\" data-row-key=\"engagement_id\" aria-label=\"Candidate audits\">\n        <thead><tr>\n          <th data-field=\"project\">Contest</th>\n          <th data-field=\"platform\">Platform</th>\n          <th class=\"num\" data-field=\"audit_year\">Year</th>\n          <th class=\"num\" data-field=\"nsloc\">nSLOC</th>\n          <th class=\"num\" data-field=\"chm\">C/H/M</th>\n          <th class=\"num\" data-field=\"high\">High</th>\n          <th class=\"num\" data-field=\"with_functions\">Name a function</th>\n          <th class=\"num\" data-field=\"with_attack\">Attack path</th>\n          <th class=\"num\" data-field=\"with_poc\">PoC test</th>\n          <th class=\"num\" data-field=\"with_fix\">Fix</th>\n          <th data-field=\"commit\">Audited code</th>\n        </tr></thead>\n        <tbody data-draw=\"shortlist\"></tbody>\n      </table>\n    </div>\n  </section>\n\n  <section class=\"ar-section\" id=\"classes\">\n    <h2>Bug types in the under-2,000-nSLOC shortlist</h2>\n    <p class=\"ar-sub\">Root-cause group of each critical, high and medium finding in funnel step 5, as labelled in the corpus.</p>\n    <div class=\"ar-card\"><div class=\"ar-chart\" data-draw=\"classes\" data-source=\"shortlist_classes\" role=\"img\" aria-label=\"Findings by root-cause group\">\u2014</div></div>\n  </section>\n\n  </div>\n\n  <div class=\"ar-panel\" id=\"starter\" role=\"tabpanel\" aria-labelledby=\"tab-starter\" data-tab-panel hidden>\n    <p class=\"ar-lede\" id=\"starter-takeaway\" data-read lang=\"en\">\n      <b data-draw=\"num\" data-source=\"starter_summary\" data-field=\"audits\" data-row=\"0\">\u2014</b> audits under 2,000 nSLOC,\n      <b data-draw=\"num\" data-source=\"starter_summary\" data-field=\"sherlock_audits\" data-row=\"0\">\u2014</b> from Sherlock and\n      <b data-draw=\"num\" data-source=\"starter_summary\" data-field=\"code4rena_audits\" data-row=\"0\">\u2014</b> from Code4rena, with\n      <b data-draw=\"num\" data-source=\"starter_summary\" data-field=\"findings\" data-row=\"0\">\u2014</b> findings:\n      <b data-draw=\"num\" data-source=\"starter_summary\" data-field=\"high\" data-row=\"0\">\u2014</b> high,\n      <b data-draw=\"num\" data-source=\"starter_summary\" data-field=\"medium\" data-row=\"0\">\u2014</b> medium and\n      <b data-draw=\"num\" data-source=\"starter_summary\" data-field=\"critical\" data-row=\"0\">\u2014</b> critical.\n      In <b data-draw=\"num\" data-source=\"starter_summary\" data-field=\"strict_audits\" data-row=\"0\">\u2014</b> of them every finding names a function in its bug description.\n    </p>\n    <p class=\"ar-sub\" data-read lang=\"en\">These are the audits from the first pass of the funnel. That pass also counted names that appear only in a PoC test, a mitigation or a comment; counting the bug description alone gives funnel step 5 on the Overview tab.</p>\n\n    <section class=\"ar-section\" id=\"starter-roots\">\n      <h2>Root causes, by severity</h2>\n      <p class=\"ar-sub\"><b data-draw=\"num\" data-source=\"starter_summary\" data-field=\"root_groups_used\" data-row=\"0\">\u2014</b> root-cause groups and\n        <b data-draw=\"num\" data-source=\"starter_summary\" data-field=\"root_classes_used\" data-row=\"0\">\u2014</b> classes appear; the median audit spans\n        <b data-draw=\"num\" data-source=\"starter_summary\" data-field=\"median_groups_per_audit\" data-row=\"0\">\u2014</b> groups. Point at a bar for its classes and platforms.</p>\n      <div class=\"ar-card\"><div class=\"ar-chart\" data-draw=\"starter-roots\" data-source=\"starter_root_causes\" role=\"img\" aria-label=\"Findings per root-cause group, split into high and medium\">\u2014</div></div>\n    </section>\n\n    <div class=\"ar-two\">\n      <section class=\"ar-section\" id=\"starter-functions\">\n        <h2>Functions named per finding</h2>\n        <p class=\"ar-sub\">Median <b data-draw=\"num\" data-source=\"starter_summary\" data-field=\"median_functions\" data-row=\"0\">\u2014</b>,\n          90th percentile <b data-draw=\"num\" data-source=\"starter_summary\" data-field=\"p90_functions\" data-row=\"0\">\u2014</b>,\n          most <b data-draw=\"num\" data-source=\"starter_summary\" data-field=\"max_functions\" data-row=\"0\">\u2014</b>.\n          <b data-draw=\"num\" data-source=\"starter_summary\" data-field=\"no_function_findings\" data-row=\"0\">\u2014</b> findings name none in the bug description.</p>\n        <div class=\"ar-card\"><div class=\"ar-chart\" data-draw=\"starter-fn-spread\" data-source=\"starter_function_spread\" role=\"img\" aria-label=\"Number of findings by how many functions they name\">\u2014</div></div>\n      </section>\n      <section class=\"ar-section\" id=\"starter-confidence\">\n        <h2>Confidence in the root-cause label</h2>\n        <p class=\"ar-sub\"><b data-draw=\"num\" data-source=\"starter_summary\" data-field=\"low_confidence\" data-row=\"0\">\u2014</b> findings score below 0.85,\n          <b data-draw=\"num\" data-source=\"starter_summary\" data-field=\"needs_review\" data-row=\"0\">\u2014</b> are flagged for review and\n          <b data-draw=\"num\" data-source=\"starter_summary\" data-field=\"unclassified\" data-row=\"0\">\u2014</b> are unclassified. The score is the classifier's own and is not calibrated.</p>\n        <div class=\"ar-card\"><div class=\"ar-chart\" data-draw=\"starter-confidence\" data-source=\"starter_confidence\" role=\"img\" aria-label=\"Number of findings by classifier confidence\">\u2014</div></div>\n      </section>\n    </div>\n\n    <section class=\"ar-section\" id=\"starter-overlap\">\n      <h2>Findings that share a function</h2>\n      <p class=\"ar-lede\" data-read lang=\"en\">\n        <b data-draw=\"num\" data-fmt=\"pct\" data-source=\"starter_summary\" data-field=\"pct_sharing\" data-row=\"0\">\u2014</b>% of findings name a function that another finding in the same audit also names.\n        Of the <b data-draw=\"num\" data-source=\"starter_summary\" data-field=\"sharing_pairs\" data-row=\"0\">\u2014</b> pairs that share one,\n        <b data-draw=\"num\" data-source=\"starter_summary\" data-field=\"pairs_diff_group\" data-row=\"0\">\u2014</b>\n        (<b data-draw=\"num\" data-fmt=\"pct\" data-source=\"starter_summary\" data-field=\"pct_pairs_diff_group\" data-row=\"0\">\u2014</b>%) have different root-cause groups and\n        <b data-draw=\"num\" data-source=\"starter_summary\" data-field=\"pairs_same_class\" data-row=\"0\">\u2014</b> have the same class.\n      </p>\n      <p class=\"ar-sub\">A function name can point at several distinct bugs, sometimes with the same class, so matching a tool's finding needs the described mechanism as well.</p>\n    </section>\n\n    <section class=\"ar-section\" id=\"starter-audits\">\n      <h2>The audits</h2>\n      <p class=\"ar-sub\">Smallest scope first. Requirement columns count critical, high and medium findings; green means all of them.</p>\n      <div class=\"ar-card ar-scroll\">\n        <table class=\"ar-table\" data-source=\"starter_audits\" data-row-key=\"engagement_id\" aria-label=\"Starter set audits\">\n          <thead><tr>\n            <th data-field=\"project\">Contest</th>\n            <th data-field=\"platform\">Platform</th>\n            <th class=\"num\" data-field=\"audit_year\">Year</th>\n            <th class=\"num\" data-field=\"nsloc\">nSLOC</th>\n            <th class=\"num\" data-field=\"chm\">C/H/M</th>\n            <th class=\"num\" data-field=\"high\">High</th>\n            <th class=\"num\" data-field=\"medium\">Medium</th>\n            <th class=\"num\" data-field=\"root_groups\">Root-cause groups</th>\n            <th data-field=\"top_group\">Most common</th>\n            <th class=\"num\" data-field=\"median_functions\">Median functions</th>\n            <th class=\"num\" data-field=\"no_function\">Name no function</th>\n            <th class=\"num\" data-field=\"with_poc\">PoC test</th>\n            <th class=\"num\" data-field=\"with_fix\">Fix</th>\n            <th data-field=\"commit\">Audited code</th>\n          </tr></thead>\n          <tbody data-draw=\"starter-audits\"></tbody>\n        </table>\n      </div>\n    </section>\n\n    <section class=\"ar-section\" id=\"starter-findings\">\n      <h2>The findings</h2>\n      <p class=\"ar-sub\">Functions are the names in the bug description. \"Shares\" counts other findings in the same audit that name one of the same functions.</p>\n      <div class=\"ar-controls\">\n        <label for=\"sf-audit\">Audit <select class=\"dash-select\" id=\"sf-audit\" data-draw=\"sf-audit\" data-source=\"starter_audits\" aria-label=\"Audit\"></select></label>\n        <label for=\"sf-group\">Root cause <select class=\"dash-select\" id=\"sf-group\" data-draw=\"sf-group\" data-source=\"starter_root_causes\" aria-label=\"Root-cause group\"></select></label>\n        <label for=\"sf-shared\"><input type=\"checkbox\" id=\"sf-shared\"> Only findings that share a function</label>\n      </div>\n      <div class=\"ar-card ar-scroll\">\n        <table class=\"ar-table\" data-source=\"starter_findings\" data-row-key=\"finding_uid\" aria-label=\"Starter set findings\">\n          <thead><tr>\n            <th data-field=\"project\">Audit</th>\n            <th data-field=\"finding_id\">ID</th>\n            <th data-field=\"title\">Title</th>\n            <th data-field=\"vuln_leaf\">Root cause</th>\n            <th class=\"num\" data-field=\"vuln_confidence\">Confidence</th>\n            <th data-field=\"functions\">Functions</th>\n            <th class=\"num\" data-field=\"shares_with\">Shares</th>\n            <th data-field=\"poc\">PoC</th>\n            <th data-field=\"fix\">Fix</th>\n          </tr></thead>\n          <tbody data-draw=\"starter-findings\"></tbody>\n        </table>\n      </div>\n    </section>\n  </div>\n\n  <details class=\"ar-notes\" id=\"notes\">\n    <summary>How each requirement is measured, and what is missing</summary>\n    <dl data-read lang=\"en\">\n      <dt>Function names</dt>\n      <dd>Functions named in the bug description, before any PoC test, mitigation or discussion: inline code, plain-text calls such as Vault.withdraw( or camelCase(, and functions defined or called in code snippets. Test helpers and language built-ins are left out.</dd>\n      <dt>Root cause</dt>\n      <dd>The corpus's own label: one class per finding from its taxonomy, assigned by an LLM from the title and first 3,000 characters. It names the earliest root cause, not the attack.</dd>\n      <dt>Attack path</dt>\n      <dd>A section headed Attack Path, Exploit Scenario, Steps to Reproduce or similar. Most reports describe the attack inside the main text, so this undercounts what an extraction pass could recover. The corpus gives every finding one root-cause class, not a set of attack vectors; building those sets needs a separate labelling pass.</dd>\n      <dt>PoC test</dt>\n      <dd>Test code in the finding: function test\u2026(, #[test], vm.prank(\u2026), forge test and similar.</dd>\n      <dt>Fix</dt>\n      <dd>A diff in the finding, or a link to a fix commit or pull request. A linked fix can be fetched as a patch.</dd>\n      <dt>Scope size</dt>\n      <dd>Sherlock nSLOC comes from Sherlock's contest API. Code4rena sizes come from each audit repo's README scope table: nSLOC where given, otherwise cloc code lines or listed file lengths, so older Code4rena sizes are approximate. Firm reviews have no scope size in the corpus.</dd>\n      <dt>Audited code</dt>\n      <dd>Sherlock's scope repo at the commit the contest used, or the Code4rena audit repo at its current default-branch commit. A private repo will not open.</dd>\n    </dl>\n  </details>\n</div>\n\n<script>\n  const fmtInt = d3.format(\",\");\n  const fmtPct = d3.format(\".1f\");\n  const PLATFORM = { sherlock: \"Sherlock contests\", code4rena: \"Code4rena contests\", cantina: \"Cantina contests\",\n    \"other contests\": \"Other contests\", \"firm reviews\": \"Firm reviews\", all: \"All sources\" };\n  const GROUP_NAMES = { mev: \"MEV\", dos: \"DoS\" };\n  const GROUP = (g) => GROUP_NAMES[g] || g.replace(/_/g, \" \").replace(/^./, (c) => c.toUpperCase());\n  window.arTip = (box) => {\n    const tip = document.createElement(\"div\");\n    tip.className = \"ar-tip\"; tip.hidden = true; box.appendChild(tip);\n    return {\n      show(event, lines) {\n        tip.replaceChildren(...lines.map((l, i) => { const d = document.createElement(\"div\"); if (i) { const s = document.createElement(\"span\"); s.textContent = l; d.appendChild(s); } else d.textContent = l; return d; }));\n        tip.hidden = false;\n        const b = box.getBoundingClientRect(), x = event.clientX - b.left, y = event.clientY - b.top;\n        tip.style.left = `${Math.max(0, Math.min(x + 12, b.width - tip.offsetWidth))}px`;\n        tip.style.top = `${Math.max(0, y - tip.offsetHeight - 10)}px`;\n      },\n      hide() { tip.hidden = true; },\n    };\n  };\n  window.arFailed = (el, d) => { el.replaceChildren(); el.textContent = d.status === \"error\" ? \"Failed to load\" : \"\u2014\"; };\n\n  dash.draw(\"num\", (el) => {\n    const d = dash.data(el.dataset.source);\n    if (d.status !== \"ok\" || !d.data.length) { el.textContent = \"\u2014\"; return; }\n    const v = d.data[Number(el.dataset.row || 0)][el.dataset.field];\n    el.textContent = el.dataset.fmt === \"pct\" ? fmtPct(v) : fmtInt(v);\n  });\n\n  dash.draw(\"coverage\", (tbody) => {\n    const d = dash.data(\"coverage_by_platform\");\n    tbody.replaceChildren();\n    if (d.status !== \"ok\") return;\n    const fields = [\"pct_has_functions\", \"pct_attack\", \"pct_poc\", \"pct_fix\", \"pct_complete\"];\n    const accent = dash.colors[0];\n    for (const r of d.data) {\n      const tr = document.createElement(\"tr\");\n      tr.dataset.key = encodeURIComponent(r.platform);\n      if (r.platform === \"all\") tr.className = \"ar-total\";\n      const name = document.createElement(\"td\"); name.textContent = PLATFORM[r.platform] || r.platform; tr.appendChild(name);\n      for (const f of [\"audits\", \"findings\"]) { const td = document.createElement(\"td\"); td.className = \"num\"; td.textContent = fmtInt(r[f]); tr.appendChild(td); }\n      for (const f of fields) {\n        const td = document.createElement(\"td\"); td.className = \"num\";\n        const v = document.createElement(\"span\"); v.className = \"ar-pct\"; v.textContent = fmtPct(r[f]); td.appendChild(v);\n        td.style.background = `linear-gradient(90deg, color-mix(in srgb, ${accent} 20%, transparent) ${r[f]}%, transparent ${r[f]}%)`;\n        tr.appendChild(td);\n      }\n      tbody.appendChild(tr);\n    }\n  });\n\n  dash.draw(\"funnel\", (el) => {\n    const d = dash.data(\"contest_funnel\");\n    if (d.status !== \"ok\" || !d.data.length) return arFailed(el, d);\n    el.replaceChildren();\n    const W = el.clientWidth, rowH = 50, H = d.data.length * rowH;\n    const max = d3.max(d.data, (r) => r.audits) || 1;\n    const svg = d3.select(el).append(\"svg\").attr(\"viewBox\", `0 0 ${W} ${H}`).attr(\"height\", H).attr(\"role\", \"presentation\");\n    const tip = arTip(el);\n    const valueW = 190, x = d3.scaleLinear().domain([0, max]).range([0, Math.max(40, W - valueW)]);\n    const g = svg.selectAll(\"g\").data(d.data).join(\"g\").attr(\"transform\", (r, i) => `translate(0,${i * rowH})`);\n    g.append(\"text\").attr(\"x\", 0).attr(\"y\", 14).style(\"font-size\", \"var(--cds-font-size-caption)\").style(\"fill\", \"var(--cds-text-secondary)\")\n      .text((r) => `${r.step}. ${r.stage}`);\n    g.append(\"rect\").attr(\"x\", 0).attr(\"y\", 20).attr(\"height\", 18).attr(\"rx\", 3).attr(\"width\", (r) => Math.max(2, x(r.audits)))\n      .style(\"fill\", dash.colors[0])\n      .on(\"mousemove\", (event, r) => tip.show(event, [`${r.stage}`, `${fmtInt(r.audits)} audits \u00b7 ${fmtInt(r.findings)} findings`,\n        `${fmtInt(r.with_poc)} findings with a PoC test`, `${fmtInt(r.with_fix)} findings with a fix`]))\n      .on(\"mouseleave\", () => tip.hide());\n    g.append(\"text\").attr(\"x\", (r) => Math.max(2, x(r.audits)) + 8).attr(\"y\", 34).style(\"font-size\", \"var(--cds-font-size-body)\")\n      .style(\"fill\", \"var(--color-fg)\").style(\"font-variant-numeric\", \"tabular-nums\")\n      .text((r) => `${fmtInt(r.audits)} audits \u00b7 ${fmtInt(r.findings)} findings`);\n  });\n\n  dash.draw(\"size\", (el) => {\n    const d = dash.data(\"nsloc_buckets\");\n    if (d.status !== \"ok\" || !d.data.length) return arFailed(el, d);\n    el.replaceChildren();\n    const W = el.clientWidth, H = 240, m = { t: 22, r: 4, b: 26, l: 4 };\n    const svg = d3.select(el).append(\"svg\").attr(\"viewBox\", `0 0 ${W} ${H}`).attr(\"height\", H).attr(\"role\", \"presentation\");\n    const tip = arTip(el);\n    const x = d3.scaleBand().domain(d.data.map((r) => r.bucket)).range([m.l, W - m.r]).padding(0.22);\n    const y = d3.scaleLinear().domain([0, d3.max(d.data, (r) => r.audits) || 1]).nice().range([H - m.b, m.t]);\n    svg.append(\"line\").attr(\"x1\", m.l).attr(\"x2\", W - m.r).attr(\"y1\", y(0)).attr(\"y2\", y(0)).style(\"stroke\", \"var(--cds-chart-axis)\");\n    const g = svg.selectAll(\"g.bar\").data(d.data).join(\"g\").attr(\"class\", \"bar\");\n    g.append(\"rect\").attr(\"x\", (r) => x(r.bucket)).attr(\"width\", x.bandwidth()).attr(\"y\", (r) => y(r.audits))\n      .attr(\"height\", (r) => Math.max(0, y(0) - y(r.audits))).attr(\"rx\", 3).style(\"fill\", dash.colors[0])\n      .on(\"mousemove\", (event, r) => tip.show(event, [`${r.bucket} nSLOC: ${fmtInt(r.audits)} contests`, `${fmtInt(r.findings)} critical/high/medium findings`,\n        `Median ${r.median_chm} per contest`, `${fmtPct(r.pct_functions)}% name a function \u00b7 ${fmtPct(r.pct_poc)}% have a PoC test`]))\n      .on(\"mouseleave\", () => tip.hide());\n    g.append(\"text\").attr(\"x\", (r) => x(r.bucket) + x.bandwidth() / 2).attr(\"y\", (r) => y(r.audits) - 6).attr(\"text-anchor\", \"middle\")\n      .style(\"font-size\", \"var(--cds-font-size-caption)\").style(\"fill\", \"var(--color-fg)\").style(\"font-variant-numeric\", \"tabular-nums\").text((r) => fmtInt(r.audits));\n    g.append(\"text\").attr(\"x\", (r) => x(r.bucket) + x.bandwidth() / 2).attr(\"y\", H - 8).attr(\"text-anchor\", \"middle\")\n      .style(\"font-size\", \"var(--cds-font-size-caption)\").style(\"fill\", \"var(--cds-text-secondary)\").text((r) => r.bucket);\n  });\n\n  document.querySelectorAll(\"#ar-max-loc, #ar-all-fn\").forEach((c) => c.addEventListener(\"change\", () => dash.draw(\"shortlist\")));\n\n  dash.draw(\"shortlist\", (tbody) => {\n    const d = dash.data(\"candidate_audits\");\n    tbody.replaceChildren();\n    if (d.status !== \"ok\") return;\n    const sel = document.querySelector(\"#ar-max-loc\"), all = document.querySelector(\"#ar-all-fn\");\n    const maxLoc = sel && sel.value ? Number(sel.value) : Infinity;\n    const rows = d.data.filter((r) => r.nsloc < maxLoc && (!all || !all.checked || r.all_functions));\n    const link = (href, text) => {\n      if (!href || !/^https:\\/\\//.test(href)) { const s = document.createElement(\"span\"); s.textContent = text; return s; }\n      const a = document.createElement(\"a\"); a.href = href; a.target = \"_blank\"; a.rel = \"noopener noreferrer\"; a.textContent = text; return a;\n    };\n    for (const r of rows) {\n      const tr = document.createElement(\"tr\");\n      tr.dataset.key = encodeURIComponent(r.engagement_id);\n      const cells = [\n        () => link(r.contest_url, r.project),\n        () => r.platform === \"sherlock\" ? \"Sherlock\" : \"Code4rena\",\n        () => String(r.audit_year ?? \"\"),\n        () => {\n          const s = document.createElement(\"span\"); s.textContent = fmtInt(r.nsloc);\n          if (![\"nsloc\", \"sherlock_api\", \"heading_sloc\"].includes(r.nsloc_method)) { s.className = \"ar-approx\"; s.title = \"Approximate: README listed line counts, not nSLOC\"; }\n          return s;\n        },\n        () => fmtInt(r.chm),\n        () => fmtInt(r.high),\n      ];\n      cells.forEach((make, i) => {\n        const td = document.createElement(\"td\"); if (i >= 2) td.className = \"num\";\n        const v = make(); if (typeof v === \"string\") td.textContent = v; else td.appendChild(v);\n        tr.appendChild(td);\n      });\n      for (const f of [\"with_functions\", \"with_attack\", \"with_poc\", \"with_fix\"]) {\n        const td = document.createElement(\"td\"); td.className = \"num\";\n        td.textContent = fmtInt(r[f]);\n        if (r[f] === r.chm) td.classList.add(\"ar-all\"); else if (!r[f]) td.classList.add(\"ar-none\");\n        tr.appendChild(td);\n      }\n      const code = document.createElement(\"td\"); code.appendChild(link(r.code_url, r.commit ? r.commit.slice(0, 7) : \"\u2014\")); tr.appendChild(code);\n      tbody.appendChild(tr);\n    }\n    if (!rows.length) {\n      const tr = document.createElement(\"tr\"), td = document.createElement(\"td\");\n      td.colSpan = 11; td.className = \"ar-none\"; td.textContent = \"No audits match these filters.\"; tr.appendChild(td); tbody.appendChild(tr);\n    }\n  });\n\n  dash.draw(\"classes\", (el) => {\n    const d = dash.data(\"shortlist_classes\");\n    if (d.status !== \"ok\" || !d.data.length) return arFailed(el, d);\n    el.replaceChildren();\n    const W = el.clientWidth, rowH = 26, H = d.data.length * rowH + 4;\n    const svg = d3.select(el).append(\"svg\").attr(\"viewBox\", `0 0 ${W} ${H}`).attr(\"height\", H).attr(\"role\", \"presentation\");\n    const labels = svg.append(\"g\");\n    labels.selectAll(\"text\").data(d.data).join(\"text\").attr(\"x\", 0).attr(\"y\", (r, i) => i * rowH + 17)\n      .style(\"font-size\", \"var(--cds-font-size-caption)\").style(\"fill\", \"var(--cds-text-secondary)\").text((r) => GROUP(r.vuln_group));\n    const lw = Math.min(W * 0.45, d3.max(labels.selectAll(\"text\").nodes(), (n) => n.getComputedTextLength()) + 12);\n    const x = d3.scaleLinear().domain([0, d3.max(d.data, (r) => r.findings) || 1]).range([0, Math.max(30, W - lw - 44)]);\n    svg.selectAll(\"rect\").data(d.data).join(\"rect\").attr(\"x\", lw).attr(\"y\", (r, i) => i * rowH + 5).attr(\"height\", 16).attr(\"rx\", 3)\n      .attr(\"width\", (r) => Math.max(2, x(r.findings))).style(\"fill\", dash.colors[0]);\n    svg.selectAll(\"text.v\").data(d.data).join(\"text\").attr(\"class\", \"v\").attr(\"x\", (r) => lw + Math.max(2, x(r.findings)) + 6)\n      .attr(\"y\", (r, i) => i * rowH + 17).style(\"font-size\", \"var(--cds-font-size-caption)\").style(\"fill\", \"var(--color-fg)\")\n      .style(\"font-variant-numeric\", \"tabular-nums\").text((r) => fmtInt(r.findings));\n  });\n\n  // Tabs: one panel shown at a time; the open tab is kept in the link.\n  window.arShowTab = (tab) => {\n    document.querySelectorAll(\"[data-tab-panel]\").forEach((p) => { p.hidden = p.id !== tab; });\n    document.querySelectorAll(\"[data-tab]\").forEach((b) => b.setAttribute(\"aria-selected\", String(b.dataset.tab === tab)));\n  };\n  document.querySelectorAll(\"[data-tab]\").forEach((b) => b.addEventListener(\"click\", () => { arShowTab(b.dataset.tab); dash.setLink(b.dataset.tab); }));\n  if (location.hash === \"#starter\") arShowTab(\"starter\");\n\n  // Vertical bars with a count on each bar.\n  window.arColumns = (el, rows, key, value, tipLines) => {\n    el.replaceChildren();\n    const W = el.clientWidth, H = 220, m = { t: 22, r: 4, b: 26, l: 4 };\n    const svg = d3.select(el).append(\"svg\").attr(\"viewBox\", `0 0 ${W} ${H}`).attr(\"height\", H).attr(\"role\", \"presentation\");\n    const tip = arTip(el);\n    const x = d3.scaleBand().domain(rows.map((r) => r[key])).range([m.l, W - m.r]).padding(0.22);\n    const y = d3.scaleLinear().domain([0, d3.max(rows, (r) => r[value]) || 1]).nice().range([H - m.b, m.t]);\n    svg.append(\"line\").attr(\"x1\", m.l).attr(\"x2\", W - m.r).attr(\"y1\", y(0)).attr(\"y2\", y(0)).style(\"stroke\", \"var(--cds-chart-axis)\");\n    const g = svg.selectAll(\"g.bar\").data(rows).join(\"g\").attr(\"class\", \"bar\");\n    g.append(\"rect\").attr(\"x\", (r) => x(r[key])).attr(\"width\", x.bandwidth()).attr(\"y\", (r) => y(r[value]))\n      .attr(\"height\", (r) => Math.max(0, y(0) - y(r[value]))).attr(\"rx\", 3).style(\"fill\", dash.colors[0])\n      .on(\"mousemove\", (event, r) => tip.show(event, tipLines(r))).on(\"mouseleave\", () => tip.hide());\n    g.append(\"text\").attr(\"x\", (r) => x(r[key]) + x.bandwidth() / 2).attr(\"y\", (r) => y(r[value]) - 6).attr(\"text-anchor\", \"middle\")\n      .style(\"font-size\", \"var(--cds-font-size-caption)\").style(\"fill\", \"var(--color-fg)\").style(\"font-variant-numeric\", \"tabular-nums\")\n      .text((r) => fmtInt(r[value]));\n    g.append(\"text\").attr(\"x\", (r) => x(r[key]) + x.bandwidth() / 2).attr(\"y\", H - 8).attr(\"text-anchor\", \"middle\")\n      .style(\"font-size\", \"var(--cds-font-size-caption)\").style(\"fill\", \"var(--cds-text-secondary)\").text((r) => r[key]);\n  };\n\n  dash.draw(\"starter-fn-spread\", (el) => {\n    const d = dash.data(\"starter_function_spread\");\n    if (d.status !== \"ok\" || !d.data.length) return arFailed(el, d);\n    arColumns(el, d.data, \"functions\", \"findings\", (r) => [`${r.functions} function${r.functions === \"1\" ? \"\" : \"s\"}`, `${fmtInt(r.findings)} findings`]);\n  });\n\n  dash.draw(\"starter-confidence\", (el) => {\n    const d = dash.data(\"starter_confidence\");\n    if (d.status !== \"ok\" || !d.data.length) return arFailed(el, d);\n    arColumns(el, d.data, \"confidence\", \"findings\", (r) => [`Confidence ${r.confidence}`, `${fmtInt(r.findings)} findings`]);\n  });\n\n  dash.draw(\"starter-roots\", (el) => {\n    const d = dash.data(\"starter_root_causes\");\n    if (d.status !== \"ok\" || !d.data.length) return arFailed(el, d);\n    el.replaceChildren();\n    const rows = d.data, W = el.clientWidth, rowH = 26, legendH = 24, H = rows.length * rowH + legendH + 4;\n    const svg = d3.select(el).append(\"svg\").attr(\"viewBox\", `0 0 ${W} ${H}`).attr(\"height\", H).attr(\"role\", \"presentation\");\n    const tip = arTip(el);\n    const parts = [[\"high\", \"High\", dash.colors[0]], [\"medium\", \"Medium\", dash.colors[1] || \"var(--cds-chart-muted)\"]];\n    const legend = svg.append(\"g\");\n    parts.forEach(([, label, color], i) => {\n      const lg = legend.append(\"g\").attr(\"transform\", `translate(${i * 90},4)`);\n      lg.append(\"rect\").attr(\"width\", 11).attr(\"height\", 11).attr(\"rx\", 2).style(\"fill\", color);\n      lg.append(\"text\").attr(\"x\", 16).attr(\"y\", 10).style(\"font-size\", \"var(--cds-font-size-caption)\").style(\"fill\", \"var(--cds-text-secondary)\").text(label);\n    });\n    const body = svg.append(\"g\").attr(\"transform\", `translate(0,${legendH})`);\n    const labels = body.selectAll(\"text.l\").data(rows).join(\"text\").attr(\"class\", \"l\").attr(\"x\", 0).attr(\"y\", (r, i) => i * rowH + 17)\n      .style(\"font-size\", \"var(--cds-font-size-caption)\").style(\"fill\", \"var(--cds-text-secondary)\").text((r) => GROUP(r.vuln_group));\n    const lw = Math.min(W * 0.45, d3.max(labels.nodes(), (n) => n.getComputedTextLength()) + 12);\n    const x = d3.scaleLinear().domain([0, d3.max(rows, (r) => r.findings) || 1]).range([0, Math.max(30, W - lw - 44)]);\n    rows.forEach((r, i) => {\n      let x0 = lw;\n      for (const [k, label, color] of parts) {\n        const w = x(r[k]);\n        body.append(\"rect\").attr(\"x\", x0).attr(\"y\", i * rowH + 5).attr(\"height\", 16).attr(\"width\", Math.max(0, w)).style(\"fill\", color)\n          .on(\"mousemove\", (event) => tip.show(event, [`${GROUP(r.vuln_group)}: ${fmtInt(r.findings)} findings in ${fmtInt(r.audits)} audits`,\n            `${fmtInt(r.high)} high \u00b7 ${fmtInt(r.medium)} medium`, `${fmtInt(r.classes)} classes`, `Sherlock ${fmtInt(r.sherlock)} \u00b7 Code4rena ${fmtInt(r.code4rena)}`]))\n          .on(\"mouseleave\", () => tip.hide());\n        x0 += w;\n      }\n      body.append(\"text\").attr(\"x\", x0 + 6).attr(\"y\", i * rowH + 17).style(\"font-size\", \"var(--cds-font-size-caption)\").style(\"fill\", \"var(--color-fg)\")\n        .style(\"font-variant-numeric\", \"tabular-nums\").text(fmtInt(r.findings));\n    });\n  });\n\n  window.arLink = (href, text) => {\n    if (!href || !/^https:\\/\\//.test(href)) { const s = document.createElement(\"span\"); s.textContent = text; return s; }\n    const a = document.createElement(\"a\"); a.href = href; a.target = \"_blank\"; a.rel = \"noopener noreferrer\"; a.textContent = text; return a;\n  };\n  window.arCell = (tr, content, cls) => {\n    const td = document.createElement(\"td\"); if (cls) td.className = cls;\n    if (content instanceof Node) td.appendChild(content); else td.textContent = content;\n    tr.appendChild(td); return td;\n  };\n\n  dash.draw(\"starter-audits\", (tbody) => {\n    const d = dash.data(\"starter_audits\");\n    tbody.replaceChildren();\n    if (d.status !== \"ok\") return;\n    for (const r of d.data) {\n      const tr = document.createElement(\"tr\"); tr.dataset.key = encodeURIComponent(r.engagement_id);\n      arCell(tr, arLink(r.contest_url, r.project));\n      arCell(tr, r.platform === \"sherlock\" ? \"Sherlock\" : \"Code4rena\");\n      arCell(tr, String(r.audit_year ?? \"\"), \"num\");\n      const size = document.createElement(\"span\"); size.textContent = fmtInt(r.nsloc);\n      if (![\"nsloc\", \"sherlock_api\", \"heading_sloc\"].includes(r.nsloc_method)) { size.className = \"ar-approx\"; size.title = \"Approximate: README listed line counts, not nSLOC\"; }\n      arCell(tr, size, \"num\");\n      for (const f of [\"chm\", \"high\", \"medium\", \"root_groups\"]) arCell(tr, fmtInt(r[f]), \"num\");\n      arCell(tr, GROUP(r.top_group));\n      arCell(tr, fmtInt(r.median_functions), \"num\");\n      arCell(tr, fmtInt(r.no_function), r.no_function ? \"num ar-low\" : \"num ar-none\");\n      for (const f of [\"with_poc\", \"with_fix\"]) arCell(tr, fmtInt(r[f]), r[f] === r.chm ? \"num ar-all\" : r[f] ? \"num\" : \"num ar-none\");\n      arCell(tr, arLink(r.code_url, r.commit ? r.commit.slice(0, 7) : \"\u2014\"));\n      tbody.appendChild(tr);\n    }\n  });\n\n  dash.draw(\"sf-audit\", (sel) => {\n    const d = dash.data(\"starter_audits\"), keep = sel.value;\n    const rows = d.status === \"ok\" ? d.data.slice().sort((a, b) => a.project.localeCompare(b.project)) : [];\n    sel.replaceChildren(new Option(\"All audits\", \"\"), ...rows.map((r) => new Option(r.project, r.engagement_id)));\n    sel.value = keep || \"\";\n    sel.onchange = () => dash.draw(\"starter-findings\");\n  });\n  dash.draw(\"sf-group\", (sel) => {\n    const d = dash.data(\"starter_root_causes\"), keep = sel.value;\n    sel.replaceChildren(new Option(\"All root causes\", \"\"), ...(d.status === \"ok\" ? d.data : []).map((r) => new Option(GROUP(r.vuln_group), r.vuln_group)));\n    sel.value = keep || \"\";\n    sel.onchange = () => dash.draw(\"starter-findings\");\n  });\n  document.querySelectorAll(\"#sf-shared\").forEach((c) => c.addEventListener(\"change\", () => dash.draw(\"starter-findings\")));\n\n  dash.draw(\"starter-findings\", (tbody) => {\n    const d = dash.data(\"starter_findings\");\n    tbody.replaceChildren();\n    if (d.status !== \"ok\") return;\n    const audit = document.querySelector(\"#sf-audit\")?.value || \"\", group = document.querySelector(\"#sf-group\")?.value || \"\";\n    const shared = document.querySelector(\"#sf-shared\")?.checked;\n    const rows = d.data.filter((r) => (!audit || r.engagement_id === audit) && (!group || r.vuln_group === group) && (!shared || r.shares_with > 0));\n    for (const r of rows) {\n      const tr = document.createElement(\"tr\"); tr.dataset.key = encodeURIComponent(r.finding_uid);\n      arCell(tr, r.project, \"ar-wrap\");\n      const id = document.createElement(\"span\"); id.textContent = r.finding_id; if (r.severity === \"high\") id.className = \"ar-sev-high\";\n      arCell(tr, id);\n      arCell(tr, arLink(r.source_url, r.title), \"ar-wrap\");\n      arCell(tr, r.vuln_leaf || \"unlabelled\");\n      arCell(tr, d3.format(\".2f\")(r.vuln_confidence), r.vuln_confidence < 0.85 ? \"num ar-low\" : \"num\");\n      arCell(tr, r.functions || \"none\", r.functions ? \"ar-fns\" : \"ar-fns ar-low\");\n      arCell(tr, fmtInt(r.shares_with), r.shares_with ? \"num\" : \"num ar-none\");\n      arCell(tr, r.poc ? \"Yes\" : \"No\", r.poc ? \"\" : \"ar-none\");\n      arCell(tr, r.fix ? \"Yes\" : \"No\", r.fix ? \"\" : \"ar-none\");\n      tbody.appendChild(tr);\n    }\n    if (!rows.length) { const tr = document.createElement(\"tr\"); const td = arCell(tr, \"No fi